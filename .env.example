APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hr_wima
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Docker Configuration
APP_PORT=8080
APP_HTTPS_PORT=8443
DB_DATABASE=ciblerh
DB_USERNAME=ciblerh
DB_PASSWORD=password
TZ=Africa/Douala

# Database Seeding Control
# FORCE_SEED=false          # Set to true to always run fresh migrations with seed
# SKIP_SEED=false           # Set to true to skip seeding entirely
# FORCE_CACHE_CLEAR=false   # Set to true to force cache clearing in production

# Orange Cameroon — Messaging Pro (https://developer.orange.com/apis/messagingpro-cameroon/api-reference)
ORANGE_CM_API_URL=https://api.orange.com
ORANGE_CM_TOKEN_URL=https://api.orange.com/oauth/v3/token
ORANGE_CM_TOKEN_METHOD=post
# Send SMS: https://api.orange.com/messaging/v1/sms/simple (see Messaging Pro getting-started)
ORANGE_CM_SMS_ENDPOINT=/messaging/v1/sms/simple
# Messaging Pro bundle login (api.orange.cm) — optional if stored in Settings → SMS → Orange Cameroon
ORANGE_CM_MSP_AUTH_URL=https://api.orange.cm/messaging/api/v1/authenticate
ORANGE_CM_MSP_USERNAME=
ORANGE_CM_MSP_PASSWORD=
ORANGE_CM_CAMPAIGN_TITLE=Payslip
# Max 8 characters (Orange Messaging Pro API)
ORANGE_CM_PROJECT_NAME=Payroll
ORANGE_CM_MESSAGE_MAX_LENGTH=160
ORANGE_CM_CONTRACTS_ENDPOINT=/sms/admin/v1/contracts
ORANGE_CM_APP_ID=
ORANGE_CM_COUNTRY=CMR
ORANGE_CM_DEFAULT_COUNTRY_CODE=237
ORANGE_CM_DEFAULT_SENDER_ADDRESS=
# Optional; helps some Orange edges return well-formed HTTP (avoid CSP/header parse errors)
# ORANGE_CM_HTTP_USER_AGENT=CiblerhPayroll/1.0
# Set false only for debugging; production uses PHP cURL for api.orange.cm to avoid Guzzle CSP header parse bugs
# ORANGE_CM_USE_PHP_CURL_FOR_ORANGE_CM=true
# Rare: show 0 when the contracts JSON has no recognizable unit fields (otherwise balance shows as N/A)
# ORANGE_CM_TRUST_ZERO_CONTRACTS_BALANCE=false
