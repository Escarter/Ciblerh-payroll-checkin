APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hr_wima
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Docker Configuration
APP_PORT=8080
APP_HTTPS_PORT=8443
DB_DATABASE=ciblerh
DB_USERNAME=ciblerh
DB_PASSWORD=password
TZ=Africa/Douala

# Database Seeding Control
# FORCE_SEED=false          # Set to true to always run fresh migrations with seed
# SKIP_SEED=false           # Set to true to skip seeding entirely
# FORCE_CACHE_CLEAR=false   # Set to true to force cache clearing in production

# Orange Cameroon — Business Messaging Ngage (https://businessmessaging.orange.cm)
# Login email/password and sender are stored per-company in Settings → SMS → Orange Cameroon.
ORANGE_CM_LOGIN_URL=https://businessmessaging.orange.cm/api/v1/accounts/users/login
ORANGE_CM_SEND_URL=https://businessmessaging.orange.cm/api/v1/sms/send
ORANGE_CM_SCHEDULE_URL=https://businessmessaging.orange.cm/api/v1/campaigns/sms/send
# Mandatory send body defaults (case-sensitive on Orange's side).
# Must be a category accepted by your Ngage account (e.g. Promo). "Transactionnel" is rejected as Invalid Payload.
ORANGE_CM_CATEGORY=Promo
ORANGE_CM_COUNTRY=CM
# Delivery-report callback. Leave ORANGE_CM_DR_CALLBACK empty to auto-use this app's own endpoint
# (APP_URL + /webhooks/orange-sms/dr). Set a token to protect that endpoint (recommended).
ORANGE_CM_DR_CALLBACK=
ORANGE_CM_DR_CALLBACK_AUTO=true
ORANGE_CM_DR_CALLBACK_TOKEN=
ORANGE_CM_MESSAGE_MAX_LENGTH=160
ORANGE_CM_DEFAULT_COUNTRY_CODE=237
ORANGE_CM_DEFAULT_SENDER=
# Token validity per the spec is 3600s (1h).
ORANGE_CM_TOKEN_TTL=3600
# Optional; helps some Orange edges return well-formed HTTP (avoid CSP/header parse errors)
# ORANGE_CM_HTTP_USER_AGENT=CiblerhPayroll/1.0
# Set false only for debugging; production uses PHP cURL for businessmessaging.orange.cm to avoid Guzzle CSP header parse bugs
# ORANGE_CM_USE_PHP_CURL_FOR_ORANGE_CM=true
